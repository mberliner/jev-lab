# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secretos y estado local
.env
*.local.*

# Estado local de agentes (no compartible)
.claude/settings.local.json

